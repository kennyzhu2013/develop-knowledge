    <profiles>
        <profile>
            <!-- 测试环境打包 -->
            <id>test</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>2.6</version>
                        <configuration>
                            <archive>
                                <manifest>
                                    <addClasspath>true</addClasspath>
                                    <classpathPrefix>lib/</classpathPrefix>
                                    <mainClass>com.cmic.PusherApplication</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <!-- 在Class-Path下添加配置文件的路径 -->
                                    <Class-Path>config/</Class-Path>
                                </manifestEntries>
                            </archive>
                            <includes>
                                <!-- 打jar包时，只打包class文件 -->
                                <include>**/*.class</include>
                            </includes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>2.10</version>
                        <executions>
                            <execution>
                                <id>copy-dependencies</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/lib</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>wagon-maven-plugin</artifactId>
                        <version>1.0</version>
                        <executions>
                            <execution>
                                <id>upload-deploy</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>upload-single</goal>
                                    <goal>sshexec</goal>
                                </goals>
                                <configuration>
                                    <fromFile>target/BillPusher-0.0.1-SNAPSHOT.jar</fromFile>
                                    <url>sftp://wk13802885277:admin123@10.153.90.11/home/xuyongtao/billpusher</url>
                                    <commands>
                                        <command>cd /home/xuyongtao/billpusher ; ./restart.sh</command>
                                    </commands>
                                    <displayCommandOutputs>true</displayCommandOutputs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${parent.version}</version>
                        <configuration>
                            <includes>   <!-- exclude third part jar files -->
                                <include>
                                    <groupId>nothing</groupId>
                                    <artifactId>nothing</artifactId>
                                </include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- 正式环境打包 -->
            <id>prod</id>
            <build>
                <finalName>${artifactId}-jar-with-dependencies</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${parent.version}</version>
                    </plugin>
                </plugins>
                <resources>
