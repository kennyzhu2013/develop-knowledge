<?xml version="1.0" encoding="UTF-8" ?>
<events>
    <event name="initial">
        <action application="asr" op="sendToMQ"/>
    </event>
    <event name="asr_resp">
        <condition>
            <if expression="#calculate.isFalse(${asrStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="#calculate.gt(#calculate.length(${asrText}), 45)">
                <action application="desensitization" op="sendToMQ"/>
            </else-if>
            <else>
                <action application="attribute" op="set" type = "1">
                    <attribute name="modelQcResult">1</attribute>
                </action>
                <action application="process" op="success"/>
            </else>
        </condition>
    </event>
    <event name="desensitization_resp">
        <condition>
            <if expression="#calculate.isTrue(${desensitizationStatus})">
                <action application="attribute" op="set" type = "1">
                    <attribute name="modelQcResult">1</attribute>
                </action>
                <action application="keyword" op="match"/>
                <action application="keywordAnalysis" op="sendToMQ"/>
            </if>
            <else>
                <action application="process" op="fail"/>
            </else>
        </condition>
    </event>
    <event name="keyword_resp">
        <condition>
            <if expression="#calculate.isFalse(${keywordStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="${matchedWord}.size() &lt;= 0">
                <action application="attribute" op="set" type = "1">
                    <attribute name="modelQcResult">0</attribute>
                    <attribute name="riskLevel">3</attribute>
                </action>
                <action application="attribute" op="set" type="model" data="keyword">
                    <attribute name="modelQcResult">0</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else-if>
            <else>
                <action application="attribute" op="set" type="model" data="keyword">
                    <attribute name="modelQcResult">1</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else>
        </condition>
    </event>
    <event name="keyword_analysis_resp">
        <condition>
            <if expression="#calculate.isFalse(${keywordAnalysisStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="T(Integer).valueOf(${keywordAnalysisResult}.get(0).getResult()) == 1">
                <action application="attribute" op="set" type="model" data="keywordAnalysis">
                    <attribute name="modelQcResult">0</attribute>
                </action>
                <action application="qwen" op="sendToMQ"/>
            </else-if>
            <else>
                <action application="attribute" op="set" type="model" data="keywordAnalysis">
                    <attribute name="modelQcResult">1</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else>
        </condition>
    </event>
    <event name="qwen_resp">
        <condition>
            <if expression="#calculate.isFalse(${qwenStatus})">
                <action application="process" op="fail"/>
            </if>
            <else>
                <action application="rag" op="sendToMQ">
                    <attribute name="text">qwenResult</attribute>
                </action>
            </else>
        </condition>
    </event>
    <event name="rag_resp">
        <condition>
            <if expression="#calculate.isFalse(${ragStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="${ragResults}.get(0).getScore() >= 0.9">
                <action application="attribute" op="set" type = "1">
                    <attribute name="modelQcResult">0</attribute>
                    <attribute name="riskLevel">1</attribute>
                </action>
                <action application="attribute" op="set" type="model" data="rag">
                    <attribute name="modelQcResult">0</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else-if>
            <else>
                <action application="attribute" op="set" type="model" data="rag">
                    <attribute name="modelQcResult">1</attribute>
                </action>
                <action application="rt_qc" op="sendToMQ"/>
            </else>
        </condition>
    </event>
    <event name="rt_resp">
        <condition>
            <if expression="#calculate.notNull(${rtFirstLabel}) and T(Integer).valueOf(${rtFirstLabel}) == 4">
                <action application="attribute" op="set" type = "1">
                    <attribute name="modelQcResult">0</attribute>
                    <attribute name="riskLevel">3</attribute>
                </action>
                <action application="attribute" op="set" type="model" data="rt">
                    <attribute name="modelQcResult">0</attribute>
                </action>
                <action application="deepseek" op="sendToMQ"/>
            </if>
            <else-if expression="#calculate.notNull(${rtFirstLabel}) and T(Integer).valueOf(${rtFirstLabel}) != 4">
                <action application="attribute" op="set" type="model" data="rt">
                    <attribute name="modelQcResult">1</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else-if>
            <else>
                <action application="attribute" op="set" type="model" data="rt">
                    <attribute name="modelQcResult">1</attribute>
                </action>
                <action application="deepseek" op="sendToMQ"/>
            </else>
        </condition>
    </event>
    <event name="deepseek_resp">
        <condition>
            <if expression="#calculate.isFalse(${deepSeekStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="T(Integer).valueOf(${deepSeekResult}) == 1">
                <action application="attribute" op="set" type = "1">
                    <attribute name="modelQcResult">0</attribute>
                    <attribute name="riskLevel">2</attribute>
                </action>
                <action application="attribute" op="set" type="model" data="deepSeek">
                    <attribute name="modelQcResult">1</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else-if>
            <else>
                <action application="attribute" op="set" type="model" data="deepSeek">
                    <attribute name="modelQcResult">1</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else>
        </condition>
    </event>
    <event name="end_event">
        <condition>
            <if expression="#calculate.notNull(${keywordStatus}, ${keywordAnalysisStatus}) and T(Integer).valueOf(${keywordAnalysisResult}.get(0).getResult()) != 1">
                <action application="process" op="success"/>
            </if>
            <else-if expression="#calculate.notNull(${keywordStatus}, ${keywordAnalysisStatus}, ${ragStatus}) and ${ragResults}.get(0).getScore() >= 0.9">
                <action application="process" op="success"/>
            </else-if>
            <else-if expression="#calculate.notNull(${keywordStatus}, ${keywordAnalysisStatus}, ${ragStatus}, ${rtStatus}) and (#calculate.notNull(${rtFirstLabel}) and T(Integer).valueOf(${rtFirstLabel}) != 4)">
                <action application="process" op="success"/>
            </else-if>
            <else-if expression="#calculate.notNull(${keywordStatus}, ${keywordAnalysisStatus}, ${ragStatus}, ${rtStatus}, ${deepSeekStatus})">
                <action application="process" op="success"/>
            </else-if>
        </condition>
    </event>
</events>