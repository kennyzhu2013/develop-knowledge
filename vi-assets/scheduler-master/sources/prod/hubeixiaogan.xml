<?xml version="1.0" encoding="UTF-8" ?>
<events>
    <event name="initial">
        <action application="asr" op="sendToMQ"/>
    </event>
    <event name="asr_resp">
        <condition>
            <if expression="#calculate.isFalse(${asrStatus})">
                <action application="process" op="fail"/>
            </if>
            <else>
                <action application="desensitization" op="sendToMQ"/>
            </else>
        </condition>
    </event>
    <event name="desensitization_resp">
        <condition>
            <if expression="#calculate.isTrue(${desensitizationStatus})">
                <action application="attribute" op="set" type = "1">
                    <attribute name="qcResult">1</attribute>
                </action>
                <action application="word_regex" op="match"/>
            </if>
            <else>
                <action application="process" op="fail"/>
            </else>
        </condition>
    </event>
    <event name="word_regex_resp">
        <condition>
            <if expression="#calculate.isFalse(${wordRegexStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="${wordRegexResult}.get(0)['word']['group'].size() &lt;= 0">
                <action application="keyword" op="match"/>
                <action application="keywordAnalysis" op="sendToMQ"/>
            </else-if>
            <else>
                <action application="process" op="success"/>
            </else>
        </condition>
    </event>
    <event name="keyword_resp">
        <condition>
            <if expression="#calculate.isFalse(${keywordStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="#calculate.gt(${matchedWord}.size(), 0)">
                <action application="attribute" op="set" type = "1">
                    <attribute name="qcResult">0</attribute>
                    <attribute name="riskLevel">2</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else-if>
            <else>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else>
        </condition>
    </event>
    <event name="keyword_analysis_resp">
        <condition>
            <if expression="#calculate.isFalse(${keywordAnalysisStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="T(Integer).valueOf(${keywordAnalysisResult}.get(0).getResult()) == 1">
                <action application="deepseek" op="sendToMQ"/>
            </else-if>
            <else>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else>
        </condition>
    </event>
    <event name="deepseek_resp">
        <condition>
            <if expression="#calculate.isFalse(${deepSeekStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="T(Integer).valueOf(${deepSeekResult}) == 1 and ${deepSeekReason}.contains('风险等级:高')">
                <action application="attribute" op="set" type = "1">
                    <attribute name="qcResult">0</attribute>
                    <attribute name="riskLevel">1</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else-if>
            <else-if expression="T(Integer).valueOf(${deepSeekResult}) == 1 and ${deepSeekReason}.contains('风险等级:中')">
                <action application="attribute" op="set" type = "1">
                    <attribute name="qcResult">0</attribute>
                    <attribute name="riskLevel">2</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else-if>
            <else-if expression="T(Integer).valueOf(${deepSeekResult}) == 1 and ${deepSeekReason}.contains('风险等级:低')">
                <action application="attribute" op="set" type = "1">
                    <attribute name="qcResult">0</attribute>
                    <attribute name="riskLevel">3</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else-if>
            <else-if expression="T(Integer).valueOf(${deepSeekResult}) == 1 ">
                <action application="attribute" op="set" type = "1">
                    <attribute name="qcResult">0</attribute>
                </action>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else-if>
            <else>
                <action application="event" op="sendToEvent" data="end_event"/>
            </else>
        </condition>
    </event>
    <event name="end_event">
        <condition>
            <if expression="#calculate.notNull(${keywordStatus}, ${keywordAnalysisStatus}) and T(Integer).valueOf(${keywordAnalysisResult}.get(0).getResult()) != 1">
                <action application="process" op="success"/>
            </if>
            <else-if expression="#calculate.notNull(${keywordStatus}, ${keywordAnalysisStatus}, ${deepSeekStatus})">
                <action application="process" op="success"/>
            </else-if>
        </condition>
    </event>
</events>