<?xml version="1.0" encoding="UTF-8" ?>
<events>
    <event name="initial">
        <action application="asr" op="sendToMQ"/>
    </event>
    <event name="asr_resp">
        <condition>
            <if expression="#calculate.gt(#calculate.words(${asrText}), 10)">
                <action application="scenario" op="sendToMQ"/>
            </if>
            <else>
                <action application="process" op="fail"/>
            </else>
        </condition>
    </event>
    <event name="scenario_resp">
        <condition>
            <if expression="#calculate.et(${scenarioResult}, 1)">
                <action application="keyword" op="match"/>
            </if>
            <else>
                <action application="process" op="fail"/>
            </else>
        </condition>
    </event>
    <event name="keyword_resp">
        <action application="process" op="success"/>
    </event>
</events>
