<?xml version="1.0" encoding="UTF-8" ?>
<events>
    <event name="initial">
        <action application="asr" op="sendToMQ"/>
    </event>
    <event name="asr_resp">
        <condition>
            <if expression="#calculate.isFalse(${asrStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="#calculate.gt(#calculate.length(${asrText}), 45)">
                <action application="desensitization" op="sendToMQ"/>
            </else-if>
            <else>
                <action application="process" op="fail">
                    <attribute name="model">asr</attribute>
                    <attribute name="errorMessage">转写文字长度小于45个字符</attribute>
                </action>
            </else>
        </condition>
    </event>
    <event name="desensitization_resp">
        <condition>
            <if expression="#calculate.isTrue(${desensitizationStatus})">
                <action application="keyword" op="match"/>
                <action application="rt_qc" op="sendToMQ"/>
            </if>
            <else>
                <action application="process" op="stop"/>
            </else>
        </condition>
    </event>
    <event name="keyword_resp">
        <condition>
            <if expression="#calculate.isFalse(${keywordStatus})">
                <action application="process" op="stop"/>
            </if>
            <else-if expression="#calculate.gt(${matchedWord}.size(), 0)">
                <action application="deepseek" op="sendToMQ"/>
            </else-if>
            <else>
                <action application="event" op="sendToEvent" data="rt_deepseek_resp"/>
            </else>
        </condition>
    </event>
    <event name="deepseek_resp">
        <action application="event" op="sendToEvent" data="rt_deepseek_resp"/>
    </event>
    <event name="rt_resp">
        <action application="event" op="sendToEvent" data="rt_deepseek_resp"/>
    </event>
    <event name="rt_deepseek_resp">
        <condition>
            <if expression="#calculate.notNull(${deepSeekStatus}, ${rtStatus})">
                <action application="process" op="success"/>
            </if>
            <else-if expression="#calculate.notNull(${keywordStatus}) and #calculate.lte(${matchedWord}.size(), 0) and #calculate.notNull(${rtStatus})">
                <action application="process" op="success"/>
            </else-if>
        </condition>
    </event>
</events>