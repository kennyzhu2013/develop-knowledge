<?xml version="1.0" encoding="UTF-8" ?>
<events>
    <event name="initial">
        <action application="huawei_qc" op="sendToMQ">
            <attribute name="type">0</attribute>
        </action>
    </event>
    <event name="huawei_qc_resp">
        <condition>
            <if expression="#calculate.isFalse(${huaweiQCStatus})">
                <action application="process" op="stop"/>
            </if>
            <else>
                <action application="process" op="success"/>
            </else>
        </condition>
    </event>
</events>
