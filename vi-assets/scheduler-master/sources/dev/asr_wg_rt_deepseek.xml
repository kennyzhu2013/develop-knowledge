<?xml version="1.0" encoding="UTF-8" ?>
<events>
    <event name="initial">
        <action application="asr" op="sendToMQ"/>
    </event>
    <event name="asr_resp">
        <condition>
            <if expression="#calculate.isFalse(${asrStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="#calculate.gt(#calculate.length(${asrText}), 5)">
                <action application="desensitization" op="sendToMQ"/>
            </else-if>
            <else>
                <action application="process" op="fail">
                    <attribute name="model">asr</attribute>
                    <attribute name="errorMessage">转写文字长度小于5个字符</attribute>
                </action>
            </else>
        </condition>
    </event>
    <event name="desensitization_resp">
        <condition>
            <if expression="#calculate.isTrue(${desensitizationStatus})">
                <action application="word_group" op="match"/>
            </if>
            <else>
                <action application="process" op="stop"/>
            </else>
        </condition>
    </event>
    <event name="word_group_resp">
        <condition>
            <if expression="#calculate.isFalse(${wordGroupStatus})">
                <action application="process" op="stop"/>
            </if>
            <else-if expression="#calculate.et(${wordGroupResult}, '1')">
                <action application="rt_qc" op="sendToMQ"/>
            </else-if>
            <else>
                <action application="process" op="success"/>
            </else>
        </condition>
    </event>
    <event name="rt_resp">
        <condition>
            <if expression="#calculate.isFalse(${rtStatus})">
                <action application="process" op="stop"/>
            </if>
            <else-if expression="#calculate.et(${rtFirstLabel}, 4)">
                <action application="deepseek" op="sendToMQ"/>
            </else-if>
            <else>
                <action application="process" op="success"/>
            </else>
        </condition>
    </event>
    <event name="deepseek_resp">
        <condition>
            <if expression="#calculate.isFalse(${deepSeekStatus})">
                <action application="process" op="stop"/>
            </if>
            <else>
                <action application="process" op="success"/>
            </else>
        </condition>
    </event>
</events>