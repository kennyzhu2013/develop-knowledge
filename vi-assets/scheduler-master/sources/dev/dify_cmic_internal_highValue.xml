<?xml version="1.0" encoding="UTF-8" ?>
<events>
    <event name="initial">
        <action application="asr" op="sendToMQ"/>
    </event>
    <event name="asr_resp">
        <condition>
            <if expression="#calculate.notNull(${asrText})">
                <action application="dify" op="sendToMQ">
                    <attribute name="model">cmic_internal_highValue</attribute>
                </action>
            </if>
            <else>
                <action application="process" op="fail"/>
            </else>
        </condition>
    </event>
    <event name="dify_resp">
        <condition>
            <if expression="#calculate.isFalse(${difyStatus})">
                <action application="process" op="stop"/>
            </if>
            <else>
                <action application="process" op="success"/>
            </else>
        </condition>
    </event>
</events>
