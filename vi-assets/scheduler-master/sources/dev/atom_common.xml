<?xml version="1.0" encoding="UTF-8" ?>
<events>
    <event name="initial">
        <action application="atom_process" op="atom_initial"/>
    </event>
    <event name="asr_resp">
        <condition>
            <if expression="#calculate.isFalse(${asrStatus})">
                <action application="process" op="fail"/>
            </if>
            <else-if expression="#calculate.lt(#calculate.length(${asrText}), 45)">
                <action application="process" op="fail">
                    <attribute name="model">ASR</attribute>
                    <attribute name="errorMessage">转写文字长度小于45个字符</attribute>
                </action>
            </else-if>
            <else>
                <action application="atom_process" op="atom_handler">
                    <attribute name="dify_model">cmic_internal_collection</attribute>
                </action>
            </else>
        </condition>
    </event>
    <event name="script_resp">
        <action application="atom_process" op="check_progress"/>
    </event>
