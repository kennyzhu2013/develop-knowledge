<?xml version="1.0" encoding="UTF-8" ?>
<events>
    <event name="initial">
        <action application="asr" op="sendToMQ"/>
    </event>
    <event name="asr_resp">
        <condition>
            <if expression="#calculate.notNull(${asrText})">
                <action application="huawei_qc" op="sendToMQ">
                    <attribute name="type">1</attribute>
                </action>
            </if>
            <else>
                <action application="process" op="fail"/>
            </else>
        </condition>
    </event>
    <event name="huawei_qc_resp">
        <condition>
            <if expression="#calculate.isFalse(${huaweiQCStatus})">
                <action application="process" op="stop"/>
            </if>
            <else>
                <action application="process" op="success"/>
            </else>
        </condition>
    </event>
</events>
