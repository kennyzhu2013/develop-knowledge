<?xml version="1.0" encoding="UTF-8" ?>
<events>
    <event name="initial">
        <action application="script" op="sendToMQ"/>
    </event>
    <event name="script_resp">
        <condition>
            <if expression="#calculate.isFalse(${scriptStatus})">
                <action application="process" op="fail"/>
            </if>
            <else>
                <action application="process" op="success"/>
            </else>
        </condition>
    </event>
</events>
